DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"

# Obligatorio: secreto para firmar y verificar los JWT. Sin él la API no arranca.
# Va vacío a propósito: genera uno propio por entorno (ver README, "Variables de
# entorno") y nunca reutilices el de otro entorno ni lo subas al repo.
JWT_SECRET=

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432
